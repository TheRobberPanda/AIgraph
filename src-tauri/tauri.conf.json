{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIgraph",
  "version": "0.1.0",
  "identifier": "app.aigraph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIgraph",
        "width": 1400,
        "height": 920,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2"
        ],
        "files": {
          "/usr/bin/libsherpa-onnx-c-api.so": "target/release/libsherpa-onnx-c-api.so",
          "/usr/bin/libsherpa-onnx-cxx-api.so": "target/release/libsherpa-onnx-cxx-api.so",
          "/usr/bin/libonnxruntime.so": "target/release/libonnxruntime.so"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "AIgraph contributors",
    "shortDescription": "Think out loud, get a map back",
    "longDescription": "Talk to a model, and the ideas in what you said become a map you can walk around. Every idea links back to the exact words it came from. Runs a model on your own machine by default, so nothing said to it has to leave.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
